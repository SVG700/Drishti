# ==============================================================================
# NEXORA GOD'S EYE / GEO FEATURE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# All variables are optional. NEXORA features automatic zero-configuration
# fallbacks (Keyless Esri Satellite, OpenStreetMap, OpenSky Network, and
# synthetic procedural flights) when API keys are not supplied.
#
# DO NOT COMMIT REAL KEYS OR TOKENS TO SOURCE REPOSITORIES.
# ==============================================================================

# Cesium Ion Access Token (Optional)
# Enables Cesium Ion World Terrain, Bing Aerial Imagery, and Ion 3D photogrammetry.
# When omitted, God's Eye runs in Keyless Mode with Esri World Satellite Imagery.
VITE_CESIUM_ION_TOKEN=

# Aviationstack API Key (Optional)
# Primary live global flight telemetry provider.
# Requires HTTP proxy configuration via Vite dev server.
VITE_AVIATIONSTACK_API_KEY=

# AirLabs API Key (Optional)
# Secondary live flight telemetry provider for automatic failover.
VITE_AIRLABS_API_KEY=

# Google Maps Platform API Key (Optional)
# Enables direct Photorealistic 3D Tiles in Cesium globe view.
VITE_GOOGLE_MAPS_API_KEY=
