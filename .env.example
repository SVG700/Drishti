# ==============================================================================
# DRISHTI FRONTEND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Every VITE_ variable is built into the public website bundle, where anyone
# can read it. Never put private keys here (the Gemini key belongs only to the
# AI backend, in AI-Backend/.env or on the backend host).
#
# Local development: copy to .env. Hosting (Vercel): set these in the project's
# Environment Variables settings. See DEPLOYMENT.md.
# ==============================================================================

# AI backend address (FastAPI). Defaults to http://127.0.0.1:8000 for local
# development. On Vercel, set it to the hosted backend, e.g.
# https://drishti-ai-backend.onrender.com (must be https).
VITE_API_BASE_URL=

# New God's Eye (gods-eye-view) address, framed in the God's Eye tab.
# Defaults to http://localhost:4173/. Start it locally with `npm run dev:all`
# or `npm run dev:gods-eye`; on Vercel, set it to the hosted globe, e.g.
# https://drishti-gods-eye.onrender.com/
VITE_GODS_EYE_URL=

# Cesium Ion Access Token (Optional, classic globe)
# Enables Cesium World Terrain and Ion imagery. Without it the classic globe
# uses keyless Esri World Satellite Imagery.
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform API Key (Optional, classic globe)
# Enables Photorealistic 3D Tiles. Restrict it to your site's domain in the
# Google Cloud console, since it is visible in the browser.
VITE_GOOGLE_MAPS_API_KEY=
